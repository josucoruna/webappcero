DATABASE_URL="postgresql://user:password@localhost:5432/churchteams?schema=public"

# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Code required to create an account. Share it only with people you want
# to have access.
REGISTRATION_CODE="replace-with-your-own-code"

# Used to send "forgot password" emails, via https://resend.com (free tier
# is enough for this). Without it, the reset link is only logged to the
# server console instead of emailed — fine for local development.
RESEND_API_KEY=""
# Must be an address on a domain you've verified in Resend, e.g.
# "LuaOne <noreply@tudominio.com>". Falls back to Resend's shared sandbox
# sender, which only delivers to your own Resend account email.
RESEND_FROM_EMAIL="LuaOne <onboarding@resend.dev>"
