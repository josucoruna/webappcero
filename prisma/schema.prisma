// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Una organización (iglesia) usando la app. Todo lo demás pertenece a una.
// organizationId es opcional a nivel de columna (de forma temporal) para no
// romper filas ya existentes de antes de este modelo; en la práctica siempre
// se rellena (ver src/lib/organization.ts).
model Organization {
  id               String   @id @default(cuid())
  name             String
  registrationCode String   @unique
  createdAt        DateTime @default(now())

  users User[]
  teams Team[]

  @@map("organizations")
}

// Una persona de la iglesia. isSuperAdmin da control total dentro de SU
// organización (no sobre otras organizaciones).
model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  isSuperAdmin   Boolean       @default(false)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  memberships         TeamMembership[]
  assignedPositions   Position[]
  passwordResetTokens PasswordResetToken[]
  unavailabilities    Unavailability[]

  @@map("users")
}

// Un rango de fechas en el que una persona no está disponible para servir.
model Unavailability {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@map("unavailabilities")
}

// Token de un solo uso para restablecer la contraseña por email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Un equipo de trabajo (Alabanza, Sonido, Niños, etc.)
model Team {
  id             String        @id @default(cuid())
  name           String
  description    String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  createdAt      DateTime      @default(now())

  memberships TeamMembership[]
  services    Service[]

  @@map("teams")
}

enum TeamRole {
  LEADER
  MEMBER
}

// Relación persona-equipo: define si es líder o miembro de ESE equipo.
model TeamMembership {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_memberships")
}

// Un servicio/evento de un equipo (ej: Culto del domingo) con puestos a cubrir.
model Service {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  notes     String?
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  createdAt DateTime @default(now())

  positions Position[]

  @@map("services")
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  DECLINED
}

// Un puesto dentro de un servicio (ej: "Guitarra", "Proyección") asignado a alguien.
model Position {
  id             String           @id @default(cuid())
  name           String
  service        Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId      String
  assignedUser   User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedUserId String?
  status         AssignmentStatus @default(PENDING)
  declineReason  String?
  createdAt      DateTime         @default(now())

  @@map("positions")
}
